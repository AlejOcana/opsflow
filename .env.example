# =============================================================================
# OpsFlow — Environment variables (local dev + production deploy)
# Copy to .env for local:  cp .env.example .env
# DO NOT commit real secrets. See docs/DEPLOY.md for Neon + Render + Vercel setup.
# =============================================================================

# ---------------------------------------------------------------------------
# Local / Docker Compose (default)
# ---------------------------------------------------------------------------
# Local/dev defaults — compose overrides Host to `db` internally.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=opsflow
DB_USER=postgres
DB_PASSWORD=postgres

# Local connection string — compose uses Host=db internally; override for local dev with Host=localhost
# Keep Host=localhost for `dotnet run` outside Docker; compose sets Host=db via environment.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=opsflow;Username=postgres;Password=postgres

# ---------------------------------------------------------------------------
# Neon Postgres — Production (Render)
# ---------------------------------------------------------------------------
# 1) Create free project at https://console.neon.tech  (Free tier: 1 project, 10 branches, 3GB storage, autoscale 0.25-2 CU)
# 2) In Neon dashboard: Dashboard -> Connect -> Pooled connection (pooler) -> copy string
#    Pooled is REQUIRED for Render/serverless (PgBouncer). Example:
#    DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#    Direct (non-pooled, for migrations/tools): ep-xxx.c-2.us-east-2.aws.neon.tech
#
# For .NET Npgsql, convert to Host= format:
#    ConnectionStrings__DefaultConnection=Host=ep-xxx-pooler.c-2.us-east-2.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=YOUR_PASSWORD;SslMode=Require;ChannelBinding=Require
#
# Paste the pooled Host=... string into Render > opsflow-api > Environment > ConnectionStrings__DefaultConnection
# Keep Host=ep-...-pooler... (NOT localhost/db). SslMode=Require is mandatory for Neon.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# ConnectionStrings__DefaultConnection (Neon pooled) — uncomment and fill for production/local Neon test:
# ConnectionStrings__DefaultConnection=Host=ep-xxx-pooler.c-2.us-east-2.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=YOUR_PASSWORD;SslMode=Require;ChannelBinding=Require

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
# Generate a secure key (32 bytes = 44 base64 chars; 64 bytes recommended for production):
#   openssl rand -base64 32
#   # or: openssl rand -base64 48
#   # Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# Must be same on API and any service that validates tokens. Set via env, NOT in appsettings.Production.json.
Jwt__Key=OpsFlow-Super-Secret-Key-For-JWT-Token-Generation!!REPLACE_WITH_openssl_rand_-base64_32
Jwt__Issuer=OpsFlow.Api
Jwt__Audience=OpsFlow.Api
Jwt__ExpiryMinutes=60

# ---------------------------------------------------------------------------
# CORS — Production origins (comma-separated, no spaces)
# ---------------------------------------------------------------------------
# Local: http://localhost:4200
# Prod:  https://opsflow.alejocana.es,https://opsflow-web.vercel.app
# Program.cs reads CORS__AllowedOrigins and CORS_ALLOWED_ORIGINS (double underscore -> env mapping).
# Render sets this to prod origins; locally keep localhost or leave empty to allow all.
CORS__AllowedOrigins=http://localhost:4200
# CORS__AllowedOrigins (prod example) — set in Render dashboard:
# CORS__AllowedOrigins=https://opsflow.alejocana.es,https://opsflow-web.vercel.app
# Alias for Render (single underscore form, also read):
CORS_ALLOWED_ORIGINS=https://opsflow.alejocana.es,https://opsflow-web.vercel.app

# ---------------------------------------------------------------------------
# API / Web URLs
# ---------------------------------------------------------------------------
API_URL=http://localhost:5000
WEB_URL=http://localhost:4200
# Production:
# API_URL=https://opsflow-api.onrender.com/api
# WEB_URL=https://opsflow-web.vercel.app
# Vercel env var (set in Vercel dashboard > Settings > Environment Variables):
#   API_URL=https://opsflow-api.onrender.com/api
#   # or VITE_API_URL / NEXT_PUBLIC_API_URL depending on build injection; Angular uses environment.prod.ts

# ---------------------------------------------------------------------------
# Render — Blueprint env (render.yaml)
# ---------------------------------------------------------------------------
# ASPNETCORE_ENVIRONMENT=Production is set in render.yaml (do not override locally unless testing prod).
# Render injects PORT=10000 automatically; Program.cs reads PORT. Keep ASPNETCORE_URLS=http://+:10000 in render.yaml.
# autoDeploy=false in render.yaml — manual deploys from Render dashboard.
ASPNETCORE_ENVIRONMENT=Development
PORT=5000
ASPNETCORE_URLS=http://+:5000
# For Render production:
# ASPNETCORE_ENVIRONMENT=Production
# ASPNETCORE_URLS=http://+:10000

# ---------------------------------------------------------------------------
# Vercel — Web (opsflow-web)
# ---------------------------------------------------------------------------
# Set in Vercel dashboard > opsflow-web > Settings > Environment Variables:
#   API_URL=https://opsflow-api.onrender.com/api
# Build uses opsflow-web/src/environments/environment.prod.ts which defaults to https://opsflow-api.onrender.com/api
# Replace that file's apiUrl after you get your actual Render URL (see docs/DEPLOY.md).

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# - docker-compose.yml sets ConnectionStrings__DefaultConnection with Host=db and Jwt__* to OpsFlow.Api for container networking.
# - For production, set Jwt__Key via Render secrets/env and CORS__AllowedOrigins to prod domains.
# - Never commit .env with real Neon password or Jwt__Key. This .env.example is safe to commit.
