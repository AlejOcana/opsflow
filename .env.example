# Database
# Local/dev defaults — compose overrides Host to `db` internally via ConnectionStrings__DefaultConnection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=opsflow
DB_USER=postgres
DB_PASSWORD=postgres

# Connection string — compose uses Host=db internally; override for local dev with Host=localhost
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=opsflow;Username=postgres;Password=postgres

# JWT Authentication — must match appsettings.json Jwt:Key / Issuer / Audience
Jwt__Key=OpsFlow-Super-Secret-Key-For-JWT-Token-Generation!!
Jwt__Issuer=OpsFlow.Api
Jwt__Audience=OpsFlow.Api

# API / Web URLs
API_URL=http://localhost:5000
WEB_URL=http://localhost:4200
# NOTE: docker-compose.yml sets ConnectionStrings__DefaultConnection with Host=db and Jwt__* to OpsFlow.Api for container networking.
# For production, set Jwt__Key via secrets/env and CORS__AllowedOrigins if needed.